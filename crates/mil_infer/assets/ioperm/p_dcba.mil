program(1.3)
{
    func main<ios18>(tensor<fp16, [1, 64, 1, 64]> dd, tensor<fp16, [1, 64, 1, 64]> cc, tensor<fp16, [1, 64, 1, 64]> bb) {
        bool txx = const()[val = bool(false)];
        bool tyy = const()[val = bool(true)];
        int32 ax = const()[val = int32(3)];
        tensor<fp16, [1, 64, 1, 64]> zs1 = matmul(x = dd, y = cc, transpose_x = txx, transpose_y = tyy)[name = string("zs1")];
        tensor<fp16, [1, 64, 1, 64]> zs2 = add(x = zs1, y = bb)[name = string("zs2")];
        tensor<fp16, [1, 64, 1, 64]> aa = softmax(x = zs2, axis = ax)[name = string("aa")];
    } -> (aa);
}
