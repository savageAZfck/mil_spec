program(1.3)
{
    func main<ios18>(tensor<fp16, [1, 64, 1, 64]> cc, tensor<fp16, [1, 64, 1, 64]> aa) {
        bool txx = const()[val = bool(false)];
        bool tyy = const()[val = bool(true)];
        int32 ax = const()[val = int32(3)];
        tensor<fp16, [1, 64, 1, 64]> zs1 = matmul(x = cc, y = aa, transpose_x = txx, transpose_y = tyy)[name = string("zs1")];
        tensor<fp16, [1, 64, 1, 64]> bb = softmax(x = zs1, axis = ax)[name = string("bb")];
    } -> (bb);
}
